---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  headerVariant?: 'light' | 'dark';
}

const {
  title,
  description = "Patrimed — Conseil patrimonial indépendant dédié aux professionnels de santé. Assurance vie, PER, SCPI, fiscalité.",
  canonicalPath,
  ogImage = "/og-image.jpg",
  headerVariant = 'dark',
} = Astro.props;

const siteUrl = "https://patrimed.fr";
const canonicalURL = canonicalPath ? `${siteUrl}${canonicalPath}` : new URL(Astro.url.pathname, siteUrl).href;
const fullTitle = title.includes('Patrimed') ? title : `${title} | Patrimed`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="PatriActu — Patrimed" href="/rss.xml" />

    <title>{fullTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Patrimed" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Schema.org FinancialService -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FinancialService",
      "name": "Patrimed",
      "description": "Conseil patrimonial indépendant dédié aux professionnels de santé : assurance vie, PER, SCPI, fiscalité, prévoyance.",
      "url": "https://patrimed.fr",
      "telephone": "+33177624481",
      "email": "contact@patrimed.fr",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "131 boulevard Pereire",
        "addressLocality": "Paris",
        "postalCode": "75017",
        "addressCountry": "FR"
      },
      "image": `${siteUrl}/og-image.jpg`,
      "priceRange": "€€",
      "sameAs": [
        "https://facebook.com/profile.php?id=100095108701526",
        "https://instagram.com/patrimed.fr",
        "https://linkedin.com/company/patrimed-fr/"
      ]
    })} />

    <!-- Google Analytics — chargé uniquement après consentement (exigence CNIL) -->
    <script is:inline>
      (function () {
        var GA_ID = 'G-RHR767P7QX';
        window.__loadGA = function () {
          if (window.__gaLoaded) return;
          window.__gaLoaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', GA_ID, { anonymize_ip: true });
        };
        if (localStorage.getItem('patrimed-consent') === 'granted') window.__loadGA();
      })();
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header variant={headerVariant} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Bannière de consentement cookies (CNIL : accepter et refuser au même niveau) -->
    <div
      id="cookie-banner"
      class="hidden fixed bottom-4 left-4 right-4 sm:left-auto sm:max-w-md z-[60] bg-white rounded-2xl shadow-2xl border border-gray-100 p-6"
      role="dialog"
      aria-label="Gestion des cookies"
    >
      <p class="font-display font-bold text-dark mb-2">Cookies et mesure d'audience</p>
      <p class="text-sm text-gray-500 leading-relaxed mb-4">
        Nous utilisons Google Analytics pour mesurer la fréquentation du site. Ces cookies ne sont
        déposés qu'avec votre accord.
        <a href="/donnees-personnelles" class="text-pat-plum hover:underline">En savoir plus</a>
      </p>
      <div class="flex items-center gap-3">
        <button
          id="cookie-refuse"
          class="flex-1 px-4 py-2.5 rounded-xl border-2 border-gray-200 text-gray-600 text-sm font-semibold hover:bg-gray-50 transition-colors"
        >
          Refuser
        </button>
        <button
          id="cookie-accept"
          class="flex-1 px-4 py-2.5 rounded-xl bg-pat-plum text-white text-sm font-semibold hover:bg-pat-burgundy transition-colors"
        >
          Accepter
        </button>
      </div>
    </div>

    <script is:inline>
      (function () {
        var KEY = 'patrimed-consent';
        var banner = document.getElementById('cookie-banner');
        function show() { banner.classList.remove('hidden'); }
        function hide() { banner.classList.add('hidden'); }
        function choose(value) {
          localStorage.setItem(KEY, value);
          hide();
          if (value === 'granted' && window.__loadGA) window.__loadGA();
        }
        document.getElementById('cookie-accept').addEventListener('click', function () { choose('granted'); });
        document.getElementById('cookie-refuse').addEventListener('click', function () { choose('denied'); });
        if (!localStorage.getItem(KEY)) show();
        // Lien « Gérer les cookies » (footer) : rouvre la bannière
        document.querySelectorAll('[data-cookie-settings]').forEach(function (el) {
          el.addEventListener('click', function (e) { e.preventDefault(); show(); });
        });
      })();
    </script>

    <script>
      // Scroll reveal
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('active');
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
      );

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
