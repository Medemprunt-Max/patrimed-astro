---
// Frise « Une carrière, deux métiers » : les deux marques sœurs positionnées
// sur la carrière d'un professionnel de santé. Medemprunt = bleu (#00A4FF,
// couleur de son logo), Patrimed = prune.
const jalons = [
  { label: 'Internat', sub: 'Premiers revenus' },
  { label: 'Installation', sub: 'Cabinet, SELARL' },
  { label: 'Développement', sub: 'Patrimoine, famille' },
  { label: 'Retraite', sub: 'CARMF, transmission' },
];
---

<div class="rounded-2xl border border-gray-100 bg-white p-6 md:p-10">
  <!-- Frise des jalons -->
  <div class="relative">
    <!-- Ligne de vie (desktop) -->
    <div class="hidden md:block absolute top-[7px] left-0 right-0 h-0.5 bg-gray-200"></div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-y-6 md:gap-y-0 relative">
      {jalons.map((j) => (
        <div class="md:text-center">
          <div class="w-4 h-4 rounded-full bg-white border-[3px] border-gray-300 md:mx-auto"></div>
          <p class="mt-3 font-display font-bold text-dark text-sm md:text-base">{j.label}</p>
          <p class="text-gray-400 text-xs mt-0.5">{j.sub}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Rails des deux métiers -->
  <div class="mt-8 md:mt-10 space-y-4">
    <!-- Medemprunt : le financement -->
    <div class="md:w-[74%]">
      <div class="rounded-xl p-5 text-white" style="background: linear-gradient(135deg, #2D8BE0 0%, #00A4FF 100%)">
        <div class="flex items-center justify-between gap-4 mb-2">
          <p class="font-display font-bold text-base md:text-lg">Medemprunt</p>
          <span class="text-[11px] font-semibold uppercase tracking-wide bg-white/20 rounded-full px-2.5 py-1">
            Le financement
          </span>
        </div>
        <p class="text-white/85 text-xs md:text-sm leading-relaxed">
          Premier appartement · installation · rachat de parts · assurance emprunteur
        </p>
      </div>
    </div>

    <!-- Patrimed : le patrimoine -->
    <div>
      <div class="gradient-bg rounded-xl p-5 text-white">
        <div class="flex items-center justify-between gap-4 mb-2">
          <p class="font-display font-bold text-base md:text-lg">Patrimed</p>
          <span class="text-[11px] font-semibold uppercase tracking-wide bg-white/20 rounded-full px-2.5 py-1">
            Le patrimoine
          </span>
        </div>
        <p class="text-white/85 text-xs md:text-sm leading-relaxed">
          Épargne · fiscalité · supports à frais réduits · prévoyance · retraite · transmission
        </p>
      </div>
    </div>
  </div>

  <p class="mt-6 text-gray-400 text-xs md:text-sm leading-relaxed">
    Le crédit se joue sur quelques années. Le patrimoine, lui, se construit sur toute une carrière —
    et c'est précisément la partie que personne ne surveillait.
  </p>
</div>
