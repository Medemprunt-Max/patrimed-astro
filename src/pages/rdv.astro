---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Prendre rendez-vous — Patrimed" description="Réservez votre visioconférence gratuite avec un conseiller Patrimed. Disponible 6j/7 jusqu'à 23h.">
  <link rel="stylesheet" href="https://api.patrimed.fr/rdv/static/widget.css" slot="head" />
  <section class="section-padding bg-gray-50">
    <div class="container-custom text-center mb-10">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-dark">
        Prenez <span class="gradient-text">rendez-vous</span>
      </h2>
      <p class="text-gray-500 text-lg mt-4 max-w-xl mx-auto">
        Réservez votre visio gratuite avec un conseiller Patrimed
      </p>
    </div>
    <div class="container-custom max-w-3xl">
      <div class="rounded-2xl shadow-lg overflow-hidden bg-white">
        <div
          data-rdv-widget
          data-cabinet="patrimed"
          data-base-url="https://api.patrimed.fr"
        ></div>
      </div>
    </div>
  </section>
</Layout>

<script src="https://api.patrimed.fr/rdv/static/widget.js" defer is:inline></script>
