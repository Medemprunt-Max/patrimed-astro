---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout
  title="Page introuvable — Patrimed"
  description="La page que vous cherchez n'existe pas ou a été déplacée."
>
  <section class="section-padding bg-gray-50 min-h-[60vh] flex items-center">
    <div class="container-custom text-center max-w-2xl mx-auto">
      <p class="font-display text-7xl md:text-8xl font-extrabold gradient-text mb-6">404</p>
      <h1 class="font-display text-2xl md:text-3xl font-bold text-dark mb-4">
        Cette page n'existe pas
      </h1>
      <p class="text-gray-500 text-lg mb-10">
        La page que vous cherchez a peut-être été déplacée ou supprimée.
        Retrouvez nos solutions patrimoniales ou prenez rendez-vous avec un conseiller.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/" variant="primary" size="lg">
          Retour à l'accueil
        </Button>
        <Button href="/rdv" variant="secondary" size="lg">
          Prendre rendez-vous
        </Button>
      </div>
    </div>
  </section>
</Layout>
